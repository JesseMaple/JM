<Window x:Class="ContactBook.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="联系人" Width="720" Height="860" MinWidth="640" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F8FC"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid IsHitTestVisible="False">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F9FCFE" Offset="0" />
                        <GradientStop Color="#EFF5FB" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.05,-0.1" GradientOrigin="0.05,-0.1" RadiusX="0.7" RadiusY="0.6">
                        <GradientStop Color="#A8D9ECFF" Offset="0" />
                        <GradientStop Color="#00D9ECFF" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="42,34,42,30">

                <!-- 头像 + 名字 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AvatarBorder" Width="112" Height="112" CornerRadius="24"
                            Background="Transparent" BorderBrush="#D5E3F0" BorderThickness="1.5"
                            Cursor="Hand" MouseLeftButtonUp="Avatar_Click" ToolTip="点击选择 PNG / JPEG 图片">
                        <StackPanel x:Name="AvatarHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="#9FB4C8" HorizontalAlignment="Center" />
                            <TextBlock Text="点击上传" FontSize="11" Foreground="#9FB4C8"
                                       Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" Cursor="IBeam"
                                   MouseLeftButtonUp="NameText_Click" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="NameBox" FontSize="25" Visibility="Collapsed" Padding="6,3"
                                 Background="White" BorderBrush="#DCE6F0" BorderThickness="1"
                                 LostFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown" />
                        <TextBlock Text="点击名字可以直接修改" FontSize="11.5" Foreground="#93A5B7"
                                   Margin="2,8,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 电话 -->
                <Grid Margin="0,32,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="电话" FontSize="15" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0" />
                    <WrapPanel x:Name="PhonePanel" Grid.Column="1" Orientation="Horizontal" />
                    <Button Grid.Column="2" Style="{StaticResource AddButton}" Click="AddPhone_Click"
                            VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="添加电话" />
                </Grid>
                <Border Height="1" Background="#E6EEF7" Margin="0,14,0,0" />

                <!-- 邮箱 -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="邮箱" FontSize="15" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0" />
                    <WrapPanel x:Name="EmailPanel" Grid.Column="1" Orientation="Horizontal" />
                    <Button Grid.Column="2" Style="{StaticResource AddButton}" Click="AddEmail_Click"
                            VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="添加邮箱" />
                </Grid>
                <Border Height="1" Background="#E6EEF7" Margin="0,14,0,0" />

                <!-- 地址 -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="地址" FontSize="15" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0" />
                    <WrapPanel x:Name="AddressPanel" Grid.Column="1" Orientation="Horizontal" />
                    <Button Grid.Column="2" Style="{StaticResource AddButton}" Click="AddAddress_Click"
                            VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="添加地址" />
                </Grid>
                <Border Height="1" Background="#E6EEF7" Margin="0,14,0,0" />

                <!-- 分组 -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="分组" FontSize="15" Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0" />
                    <WrapPanel x:Name="GroupPanel" Grid.Column="1" Orientation="Horizontal" />
                    <Button Grid.Column="2" Style="{StaticResource AddButton}" Click="AddGroup_Click"
                            VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="添加分组" />
                </Grid>

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,42,0,0">
                    <Button Content="取消" Width="140" Height="52" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" IsCancel="True" />
                    <Button Content="保存" Width="150" Height="52" Margin="16,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
