<UserControl x:Class="ContactBook.ContactCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Height="204" SnapsToDevicePixels="True">

    <Border x:Name="Root" CornerRadius="16" Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20,17,20,14"
            Cursor="Hand" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头像 + 名字 -->
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Border x:Name="AvatarBorder" Width="54" Height="54" CornerRadius="14"
                        Background="Transparent" BorderThickness="0" BorderBrush="Transparent"
                        Margin="0,0,14,0" />
                <TextBlock x:Name="NameText" FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="330" />
            </StackPanel>

            <!-- 电话 -->
            <Grid x:Name="PhoneRow" Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="电话" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PhoneText" Grid.Column="1" FontSize="13.5"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 邮箱 -->
            <Grid x:Name="EmailRow" Grid.Row="2" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="邮箱" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="EmailText" Grid.Column="1" FontSize="13"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 地址 -->
            <Grid x:Name="AddressRow" Grid.Row="3" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地址" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="AddressText" Grid.Column="1" FontSize="13"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 分组 -->
            <WrapPanel x:Name="GroupsPanel" Grid.Row="4" VerticalAlignment="Bottom"
                       Margin="0,10,0,0" />
        </Grid>
    </Border>
</UserControl>
